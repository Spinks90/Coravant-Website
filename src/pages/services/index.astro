---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Services"
  description="Bespoke software, ERP and SAP, integration, CRM, AI, IoT, digital transformation and support, explained in plain terms for the people who pay for them."
>
  <section class="shell py-16 sm:py-20">
    <SectionHead
      as="h1"
      title="What we do"
      lead="Eight services, described the way a business owner would describe the problem rather than the way a developer would describe the solution."
    />
  </section>

  <section class="shell pb-4">
    <div class="grid gap-px overflow-hidden rounded border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <ServiceCard
            href={`/services/${service.id}`}
            title={service.data.title}
            summary={service.data.summary}
            icon={service.data.icon}
          />
        ))
      }
    </div>
  </section>

  <section class="shell py-16">
    <div class="rounded border border-line bg-surface p-8 sm:p-10">
      <h2 class="text-2xl">Not sure which of these you need?</h2>
      <p class="mt-3 max-w-2xl text-muted">
        That is normal, and it is not your job to diagnose it. Describe what is going wrong and we
        will tell you which of these applies, or that none of them do.
      </p>
      <a href="/book" class="btn btn-primary mt-6">Book a call and find out</a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
