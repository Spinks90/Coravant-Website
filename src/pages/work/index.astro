---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Work"
  description="Projects Coravant has delivered for UK manufacturers, distributors and retailers, with the numbers that mattered."
  noindex={cases.length === 0}
>
  <section class="shell py-16 sm:py-20">
    <SectionHead
      as="h1"
      title="Work"
      lead="What we built, what it replaced, and what changed as a result."
    />
  </section>

  <section class="shell pb-8">
    {
      cases.length > 0 ? (
        <div class="grid gap-px overflow-hidden rounded border border-line bg-line md:grid-cols-2">
          {cases.map((item) => (
            <a
              href={`/work/${item.id}`}
              class="group flex flex-col gap-4 bg-surface p-7 transition-colors hover:bg-surface-2 sm:p-8"
            >
              <div class="flex flex-wrap items-baseline gap-x-3 text-sm text-muted">
                <span class="font-semibold text-accent">{item.data.sector}</span>
                <span>{item.data.client}</span>
              </div>
              <p class="font-display text-4xl font-bold tracking-[-0.03em] text-brand">
                {item.data.headline.value}
              </p>
              <p class="text-sm text-muted">{item.data.headline.label}</p>
              <h2 class="mt-2 text-xl font-semibold group-hover:underline">{item.data.title}</h2>
              <p class="text-muted">{item.data.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded border border-line bg-surface p-8 sm:p-10">
          <h2 class="text-2xl">Case studies are being written up</h2>
          <p class="mt-3 max-w-2xl text-muted">
            We are collecting the numbers from recent projects and getting client sign-off before
            publishing them. If you would like to hear about work we have done in your sector,
            ask on a call and we will talk you through it.
          </p>
          <a href="/book" class="btn btn-primary mt-6">Book a call</a>
        </div>
      )
    }
  </section>

  <CtaBand />
</BaseLayout>
