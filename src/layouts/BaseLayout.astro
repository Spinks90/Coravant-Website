---
import '@fontsource-variable/archivo';
import '@fontsource-variable/ibm-plex-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD nodes for this page, e.g. BlogPosting or FAQPage. */
  schema?: unknown[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  schema = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;

// build.format is 'file', so the preview server and the local dist both serve
// paths ending in .html. Cloudflare serves them without the extension, so the
// canonical must always be the extensionless form.
const cleanPath =
  Astro.url.pathname
    .replace(/(?:\/index)?\.html$/, '')
    .replace(/\/+$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href.replace(/\/$/, '') || site.url;
const ogImage = new URL('/og.png', site.url).href;

const organisation = {
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  logo: new URL('/favicon.svg', site.url).href,
  email: site.email,
  ...(site.phone ? { telephone: site.phone } : {}),
  foundingDate: String(site.founded),
  sameAs: [site.linkedin],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organisation,
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      publisher: { '@id': `${site.url}/#organization` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <meta name="theme-color" content="#272661" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111129" media="(prefers-color-scheme: dark)" />

    {/* Runs before first paint so the correct theme is never seen to change. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>

  <body class="min-h-dvh bg-bg text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-brand focus:px-4 focus:py-2 focus:text-on-brand"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
