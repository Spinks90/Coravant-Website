---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  title: string;
  summary: string;
  icon: string;
}

const { href, title, summary, icon } = Astro.props;
---

{/*
  A contiguous spec-sheet grid rather than floating cards: cells share borders,
  so the set reads as one table of capabilities. Hover changes colour only, with
  no lift and no shadow.
*/}
<a
  href={href}
  class="group relative flex flex-col gap-3 bg-surface p-6 transition-colors hover:bg-surface-2 focus-visible:z-10 sm:p-7"
>
  <Icon
    name={`lucide:${icon}`}
    class="size-6 text-brand transition-colors group-hover:text-accent"
    aria-hidden="true"
  />
  <h3 class="text-lg font-semibold tracking-[-0.01em]">{title}</h3>
  <p class="text-[0.95rem] leading-relaxed text-muted">{summary}</p>
  <span class="mt-auto pt-2 text-sm font-semibold text-brand group-hover:underline">
    {title} in detail
  </span>
</a>
