---
/**
 * The one orchestrated motion moment on the site: four business systems that
 * start as separate boxes and wire themselves together on load. It explains
 * what integration means to someone who does not want it explained.
 *
 * Reduced motion is handled globally in global.css, which collapses every
 * animation to its end state: the connected diagram.
 */
const nodes = [
  { label: 'Website', x: 20, y: 34 },
  { label: 'ERP', x: 280, y: 34 },
  { label: 'Stock', x: 20, y: 266 },
  { label: 'Accounts', x: 280, y: 266 },
];

const wires = [
  { d: 'M100,88 V180 H150', delay: 0.5 },
  { d: 'M360,88 V180 H310', delay: 0.62 },
  { d: 'M100,266 V180 H150', delay: 0.74 },
  { d: 'M360,266 V180 H310', delay: 0.86 },
];
---

<figure class="m-0">
  <svg
    viewBox="0 0 460 354"
    class="h-auto w-full"
    role="img"
    aria-labelledby="hero-diagram-title hero-diagram-desc"
  >
    <title id="hero-diagram-title">Four business systems connected to a single source of truth</title>
    <desc id="hero-diagram-desc">
      A website, an ERP, a stock system and an accounts package, each wired into one shared record.
    </desc>

    {
      wires.map((wire) => (
        <>
          <path
            d={wire.d}
            fill="none"
            stroke="var(--brand)"
            stroke-width="2"
            stroke-linecap="square"
            style={`--len:140; stroke-dasharray:140; stroke-dashoffset:0; animation: wire-draw .75s ease-out ${wire.delay}s backwards;`}
          />
          <circle
            r="4"
            fill="var(--accent-mark)"
            style={`offset-path: path('${wire.d}'); offset-rotate: 0deg; opacity:0; animation: pulse-travel 1.1s ease-in-out ${wire.delay + 0.75}s 1 backwards;`}
          />
        </>
      ))
    }

    {
      nodes.map((node, i) => (
        <g style={`opacity:1; animation: node-settle .5s ease-out ${i * 0.09}s backwards;`}>
          <rect
            x={node.x}
            y={node.y}
            width="160"
            height="54"
            rx="4"
            fill="var(--surface)"
            stroke="var(--border-strong)"
            stroke-width="1.5"
          />
          <text
            x={node.x + 80}
            y={node.y + 33}
            text-anchor="middle"
            fill="var(--text)"
            style="font-family: var(--font-display); font-size: 16px; font-weight: 600;"
          >
            {node.label}
          </text>
        </g>
      ))
    }

    <g style="animation: node-settle .5s ease-out .36s backwards;">
      <rect
        x="150"
        y="152"
        width="160"
        height="56"
        rx="4"
        fill="var(--brand)"
      />
      <text
        x="230"
        y="185"
        text-anchor="middle"
        fill="var(--on-brand)"
        style="font-family: var(--font-display); font-size: 14px; font-weight: 600;"
      >
        One source of truth
      </text>
    </g>
  </svg>
</figure>
